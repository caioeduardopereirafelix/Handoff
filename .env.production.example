# Modelo do .env.production usado pelo docker-compose.prod.yaml.
# Copie para .env.production no servidor, preencha e rode:
#   docker compose -f docker-compose.prod.yaml --env-file .env.production up -d
# Gere cada senha e a chave do JWT com: openssl rand -base64 48

# Endereço público do Handoff, sem barra no fim (ex.: https://handoff.seudominio.com.br).
# Usado nos links do portal e nos uploads de anexos.
PUBLIC_URL=

# Porta publicada no servidor. O Nginx com HTTPS fica na frente desta porta.
HTTP_PORT=80

# Versão das imagens publicadas pelo CD (latest ou o hash curto de um commit).
IMAGE_TAG=latest

DB_NAME=handoff
DB_USERNAME=handoff
DB_PASSWORD=

RABBITMQ_USERNAME=handoff
RABBITMQ_PASSWORD=

MINIO_ROOT_USER=handoff
MINIO_ROOT_PASSWORD=

# SMTP do provedor de e-mail (Brevo, Resend, Gmail...).
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=Handoff <nao-responda@seudominio.com.br>

HANDOFF_JWT_SECRET=
