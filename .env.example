# Copie para .env e preencha. O .env fica fora do Git.

# Banco (usado pelo docker-compose e pela aplicação)
DB_NAME=handoff
DB_USERNAME=handoff
DB_PASSWORD=

# RabbitMQ
RABBITMQ_USERNAME=handoff
RABBITMQ_PASSWORD=

# MinIO
MINIO_ROOT_USER=handoff
MINIO_ROOT_PASSWORD=

# Armazenamento de anexos (S3 compatível). Vazios = usa o MinIO local acima.
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_REGION=us-east-1
STORAGE_BUCKET=handoff
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# E-mail. Em desenvolvimento, o Mailpit do docker-compose recebe tudo (http://localhost:8025).
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=Handoff <nao-responda@handoff.local>

# Endereço público do portal do cliente, usado nos links dos e-mails
PORTAL_BASE_URL=http://localhost:8080

# Chave de assinatura do JWT (mínimo de 32 caracteres).
# Gere uma com: openssl rand -base64 48
HANDOFF_JWT_SECRET=
