# Copie para .env e preencha. O .env fica fora do Git.

# Banco (usado pelo docker-compose e pela aplicação)
DB_NAME=handoff
DB_USERNAME=handoff
DB_PASSWORD=

# RabbitMQ
RABBITMQ_USERNAME=handoff
RABBITMQ_PASSWORD=

# MinIO
MINIO_ROOT_USER=handoff
MINIO_ROOT_PASSWORD=

# Chave de assinatura do JWT (mínimo de 32 caracteres).
# Gere uma com: openssl rand -base64 48
HANDOFF_JWT_SECRET=
